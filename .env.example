# Server bind host and port
HOST=127.0.0.1
PORT=4321

# Directory for SQLite database (career-radar.db), HTTP cache, and auth secret
JOB_SCRAPER_DATA_DIR=.data

# Strong random secret for signing session cookies (auto-generated if omitted)
# AUTH_SECRET=replace-with-32-byte-random-hex

# Google OAuth 2.0 Web Client credentials (required for "Continue with Google")
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional public origin behind a reverse proxy / custom domain:
# PUBLIC_ORIGIN=https://your-app.example.com
